# =====================================================================
#  Copy this file to ".env" (same folder) and fill in your keys.
#  NEVER share your .env file or paste it into Grok / any chatbot.
# =====================================================================

# ---------------- Mode ----------------
# true  = paper trading: real market data + real Jupiter quotes, FAKE money.
# false = live trading with REAL money. Only switch after paper testing!
DRY_RUN=true
# Fake starting balance for paper mode (in SOL).
PAPER_START_SOL=2.0

# ---------------- Grok (xAI) ----------------
# Get a key at https://console.x.ai  (API usage is billed separately from X Premium)
XAI_API_KEY=
# Check https://docs.x.ai for current model names if this one stops working.
GROK_MODEL=grok-4.7
# Let Grok search X for posts about each coin before deciding (costs a bit more per call).
USE_X_SEARCH=true
# Grok must say BUY with at least this confidence (0-100) for the bot to buy.
MIN_CONFIDENCE=70
# Cost controls: max Grok calls per scan and per day.
MAX_GROK_CALLS_PER_SCAN=3
MAX_GROK_CALLS_PER_DAY=150
# Don't ask Grok about the same token again for this many minutes after a SKIP.
SKIP_RECHECK_MINUTES=60

# ---------------- Solana wallet + RPC (needed for LIVE mode only) ----------------
# Use a BRAND-NEW wallet that only holds your trading budget.
# Phantom: Settings > Manage Accounts > (account) > Show Private Key. Paste the base58 string.
SOLANA_PRIVATE_KEY=
# The public RPC works but is slow and rate limited. A free Helius / QuickNode / Triton RPC URL is better.
RPC_URL=https://api.mainnet-beta.solana.com

# ---------------- Jupiter (swaps) ----------------
# Optional but recommended: free API key from Jupiter's developer portal (higher rate limit).
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/swap/v2

# ---------------- Position size + account risk ----------------
# % of total equity per trade (hard-capped at 10). 3% of 5 SOL = 0.15 SOL per trade.
POSITION_SIZE_PCT=3
MAX_POSITION_SOL=1.0
MIN_POSITION_SOL=0.02
MAX_OPEN_POSITIONS=4
# SOL always kept in the wallet for fees and token account rent.
SOL_RESERVE=0.05
# Stop opening new trades for the rest of the UTC day after losing this % of equity.
DAILY_MAX_LOSS_PCT=10
MAX_BUYS_PER_DAY=8

# ---------------- Exit rules (enforced by code, Grok cannot change them) ----------------
# Sell everything if the position is down this % (measured as what you'd actually get selling now).
STOP_LOSS_PCT=20
# When up this %, sell TAKE_PROFIT_SELL_PCT % of the position...
TAKE_PROFIT_PCT=50
TAKE_PROFIT_SELL_PCT=50
# ...then sell the rest if it falls this % from its peak.
TRAILING_STOP_PCT=25
# Sell anything held longer than this (0 = no limit).
MAX_HOLD_HOURS=24
# Don't buy the same token again for this many hours after selling it.
REBUY_COOLDOWN_HOURS=24

# ---------------- Momentum filters (applied before Grok is asked) ----------------
MIN_LIQUIDITY_USD=40000
MIN_MARKET_CAP_USD=150000
MAX_MARKET_CAP_USD=50000000
MIN_VOLUME_H1_USD=25000
MIN_VOLUME_H24_USD=150000
MIN_TXNS_H1=150
MIN_BUY_SELL_RATIO_H1=1.1
MIN_PRICE_CHANGE_M5=-5
MIN_PRICE_CHANGE_H1=2
MAX_PRICE_CHANGE_H1=150
MIN_PRICE_CHANGE_H6=0
MIN_PAIR_AGE_MINUTES=60
MAX_VOLUME_TO_LIQUIDITY_H24=50
MIN_LIQUIDITY_TO_MCAP_PCT=3
# Also look at DexScreener boosted/promoted tokens (paid ads; still filtered + checked).
USE_DEXSCREENER_BOOSTS=true

# ---------------- Safety checks ----------------
# Skip tokens when RugCheck can't be reached.
REQUIRE_RUGCHECK=true
# RugCheck normalised score: 0 = safest, 100 = riskiest.
MAX_RUGCHECK_SCORE=50
# Comma-separated RugCheck "danger" risk names to ignore (leave empty unless you know why).
RUGCHECK_IGNORE_RISKS=
# Max % lost on a simulated buy-then-sell (catches honeypots, sell taxes, thin pools).
MAX_ROUNDTRIP_LOSS_PCT=8

# ---------------- Timing ----------------
# Check open positions every N seconds; look for new coins every N seconds.
CHECK_INTERVAL_SEC=30
SCAN_INTERVAL_SEC=300
# Set to true to log why each token was filtered out.
DEBUG=false
